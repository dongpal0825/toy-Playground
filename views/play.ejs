<%# play.ejs: 놀이터 화면. 3D 화면 위에 채팅 로그 패널(왼쪽 위)과 입력창(아래)을 겹쳐서 보여줌 %>
<!DOCTYPE html>
<html lang="ko">
<head>
  <%- include('partials/head', { title: room.name }) %>
  <link rel="stylesheet" href="/css/play.css">
  <!-- Three.js를 import 할 때 쓸 주소 (node_modules/three를 /vendor/three로 제공 중) -->
  <script type="importmap">
    { "imports": {
        "three": "/vendor/three/build/three.module.js",
        "three/addons/": "/vendor/three/examples/jsm/"
    } }
  </script>
</head>
<body class="play-page">
  <!-- 3D 놀이터가 그려지는 곳 -->
  <div id="game"></div>

  <!-- 왼쪽 위: 채팅 로그 패널 -->
  <section id="chat-panel">
    <header>
      <span id="room-name"><%= room.name %></span>
      <span id="player-count">접속 중…</span>
    </header>
    <ul id="chat-log" aria-live="polite"></ul>
  </section>

  <!-- 오른쪽 위: 나가기 버튼 + 조작법 -->
  <div id="top-right">
    <div class="top-buttons">
      <button type="button" class="btn small" id="board-open-btn">📌 게시판</button>
      <a class="btn small ghost" href="/servers">서버 선택으로</a>
    </div>
    <div id="help">
      <b>WASD</b> 이동 · <b>Space</b> 점프 · <b>우클릭 드래그</b> 시점 회전 · <b>휠</b> 확대/축소 · <b>Enter</b> 채팅 · <b>1~6</b> 이모티콘 · <b>Shift</b> 놀이기구 · 게시판
    </div>
  </div>

  <!-- 아래 가운데: 놀이기구 안내 ("Shift: 그네 타기" 등, play.js가 채움) -->
  <div id="ride-prompt" class="hidden"></div>

  <!-- 아래: 이모티콘 버튼 (play.js가 버튼을 채움) -->
  <div id="emote-bar"></div>

  <!-- 아래: 채팅 입력창 -->
  <form id="chat-form" autocomplete="off">
    <input id="chat-input" maxlength="200" placeholder="Enter를 눌러 채팅하기">
    <button class="btn small">보내기</button>
  </form>

  <!-- 3D 모델을 받는 동안 보여주는 로딩 화면 (play.js가 진행률을 갱신하고 다 받으면 숨김) -->
  <div id="loading">
    <div class="loading-box">
      <div class="loading-title">놀이터 준비 중…</div>
      <div class="loading-bar"><div id="loading-fill"></div></div>
      <div id="loading-text">0%</div>
    </div>
  </div>

  <!-- 놀이터 게시판 창 (게시판 오브젝트 앞에서 Shift 또는 오른쪽 위 버튼으로 열림, board.js가 내용을 채움) -->
  <div id="board" class="hidden" role="dialog" aria-label="놀이터 게시판">
    <div class="board-box">
      <header class="board-head">
        <span class="board-title">📌 놀이터 게시판</span>
        <span class="board-sub" id="board-sub"></span>
        <button type="button" class="board-close" id="board-close" title="닫기 (Esc)">✕</button>
      </header>
      <p class="board-error hidden" id="board-error"></p>

      <!-- 목록 -->
      <section id="board-list-view">
        <div class="board-actions"><button type="button" class="btn small" id="board-write">✏️ 글쓰기</button></div>
        <ul id="board-list"></ul>
      </section>

      <!-- 글 읽기 -->
      <section id="board-read-view" class="hidden">
        <h3 id="board-read-title"></h3>
        <p class="board-meta" id="board-read-meta"></p>
        <div class="board-content" id="board-read-content"></div>
        <div class="board-actions">
          <button type="button" class="btn small ghost" id="board-back">← 목록</button>
          <span class="spacer"></span>
          <button type="button" class="btn small" id="board-edit">수정</button>
          <button type="button" class="btn small danger" id="board-delete">삭제</button>
        </div>
      </section>

      <!-- 글쓰기 / 수정 -->
      <form id="board-form-view" class="hidden" autocomplete="off">
        <input id="board-input-title" maxlength="50" placeholder="제목 (50자까지)" required>
        <textarea id="board-input-content" maxlength="1000" rows="8" placeholder="친구들과 나누고 싶은 이야기를 적어 보세요 (1000자까지)" required></textarea>
        <div class="board-actions">
          <span class="board-count" id="board-count">0 / 1000</span>
          <span class="spacer"></span>
          <button type="button" class="btn small ghost" id="board-cancel">취소</button>
          <button class="btn small" id="board-save">등록</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 3D를 못 띄울 때나 연결이 끊겼을 때 보여주는 안내 -->
  <div id="notice" class="hidden"></div>

  <!-- 서버가 화면에 넘겨주는 정보 (내 정보, 장난감 모델 파일 목록) -->
  <script id="page-data" type="application/json"><%- JSON.stringify({
      roomId: room.id,
      assetVersion: assetVersion,
      me: { nickname: user.nickname, toyId: user.toyId, color: user.color },
      toys: toys.map((t) => ({ id: t.id, name: t.name, model: t.model_file }))
    }).replace(/</g, '\\u003c') %></script>
  <script src="/socket.io/socket.io.js"></script>
  <script type="module" src="/js/play.js"></script>
</body>
</html>
